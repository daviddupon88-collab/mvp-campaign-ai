# Base de données
DATABASE_URL="postgresql://campaignai:campaignai@localhost:5432/campaignai"

# Redis (queue + cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_SECRET=change-me-in-production
# Secret dédié à la signature du paramètre state OAuth (cf. oauth-state.service.ts).
# Repli sur JWT_SECRET si absent — à définir explicitement en production.
OAUTH_STATE_SECRET=
# Rotation de OAUTH_STATE_SECRET (aucun script requis — rien n'est stocké durablement sous
# ce secret, contrairement à TOKEN_ENCRYPTION_KEY) :
#   1. Générer le nouveau secret : openssl rand -base64 32
#   2. Déployer avec OAUTH_STATE_SECRET=<nouveau> ET OAUTH_STATE_SECRET_PREVIOUS=<ancien> —
#      les états OAuth déjà en vol (signés sous l'ancien secret, TTL 10 min) restent acceptés.
#   3. Attendre au moins 10 minutes après le déploiement (durée de vie max d'un state).
#   4. Retirer OAUTH_STATE_SECRET_PREVIOUS.
OAUTH_STATE_SECRET_PREVIOUS=

# Chiffrement au repos des tokens OAuth (réseaux sociaux, boutiques e-commerce).
# Générer avec : openssl rand -base64 32
# ABSENTE = tokens stockés en clair — acceptable en dev local uniquement, jamais en production.
TOKEN_ENCRYPTION_KEY=

# URLs publiques (nécessaires aux redirections OAuth et aux liens Stripe)
API_PUBLIC_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# IA — passer à "live" une fois les clés ci-dessous renseignées.
# En mode "mock", toutes les générations sont simulées (aucune clé requise).
# ---------------------------------------------------------------------------
AI_MODE=mock

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Image — Flux (via Replicate) et Ideogram, utilisés en priorité par l'AI Gateway
REPLICATE_API_TOKEN=
IDEOGRAM_API_KEY=

# Vidéo — Google Veo (Vertex AI)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1
# Token statique pour développement uniquement — en production, générer dynamiquement
# via google-auth-library plutôt qu'une variable d'environnement (expire après 1h).
GOOGLE_CLOUD_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Réseaux sociaux — Module 14 Social Publishing Hub
# Chaque app doit être créée et validée (review) sur le portail développeur
# de la plateforme correspondante avant de fonctionner en production.
# ---------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Requis si le compte connecté est géré via un compte manager (MCC) Google Ads.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Stripe — facturation et abonnements
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=

# Packs de crédits ponctuels (mode paiement unique, pas d'abonnement) — cf. plan-catalog.ts
STRIPE_PRICE_CREDIT_PACK_SMALL=
STRIPE_PRICE_CREDIT_PACK_MEDIUM=
STRIPE_PRICE_CREDIT_PACK_LARGE=

PORT=3001

# ---------------------------------------------------------------------------
# Observabilité — Tests, Sécurité & Observabilité
# ---------------------------------------------------------------------------
# Suivi d'erreurs Sentry — absent = Sentry.init() reste un no-op silencieux, aucune erreur.
SENTRY_DSN=
NODE_ENV=development

# ---------------------------------------------------------------------------
# Notifications — Conformité & Exploitation
# ---------------------------------------------------------------------------
# Fournisseur email (Resend). Absent = les emails sont journalisés en log structuré plutôt
# qu'envoyés, même principe que AI_MODE=mock — permet de tester sans compte fournisseur.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS="Campaign-ai <notifications@campaign-ai.example.com>"

# ---------------------------------------------------------------------------
# Stockage d'objets (images, vidéos, logos, fichiers) — cf. storage.service.ts
# ---------------------------------------------------------------------------
# local (défaut) = disque du conteneur, jamais durable, dev/test uniquement, aucune
#   configuration requise, même principe que AI_MODE=mock.
# s3 = tout fournisseur compatible S3 (AWS S3, Cloudflare R2, Google Cloud Storage en
#   mode interopérabilité S3, MinIO, Backblaze B2) — une seule implémentation les couvre
#   tous, seuls l'endpoint et la région changent.
STORAGE_PROVIDER=local

# Requis uniquement si STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=auto
# Laisser vide pour AWS S3 standard. Exemples pour les autres fournisseurs :
#   Cloudflare R2  : https://<account_id>.r2.cloudflarestorage.com
#   MinIO          : http://localhost:9000 (ou l'URL de votre instance)
#   Backblaze B2   : https://s3.<region>.backblazeb2.com
#   GCS (interop)  : https://storage.googleapis.com
STORAGE_ENDPOINT=
# true requis pour MinIO et certaines configurations R2 (URLs de la forme
# endpoint/bucket/clé plutôt que bucket.endpoint/clé).
STORAGE_FORCE_PATH_STYLE=false
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# URL publique de base pour construire les liens vers les fichiers (bucket public, ou
# domaine CDN devant le bucket — ex: https://cdn.campaign-ai.example.com).
STORAGE_PUBLIC_URL_BASE=

